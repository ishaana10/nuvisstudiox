{
    "name": "nubuilder/nuvis",
    "description": "Nuvis - Low-Code Enterprise Application Platform",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "onelogin/php-saml": "^4.0",
        "league/oauth2-client": "^2.7",
        "paragonie/ciphersweet": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "Nuvis\\": "core/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nuvis\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "stan": "phpstan analyse --memory-limit=1G",
        "security": "composer audit",
        "check": [
            "@stan",
            "@test",
            "@security"
        ]
    }
}
